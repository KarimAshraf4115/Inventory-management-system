generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Supplier {
  supplierId       Int       @id @default(autoincrement()) @map("supplier_id")
  name             String    @map("name")
  phoneNum         String?   @unique @map("Phone-Num")
  type             String?   @map("Type") // "factory" or "office"
  purchaseInvoices Invoice[] @relation("SupplierInvoices")
  returns          Return[]  @relation("SupplierReturns")

  @@map("Suppliers")
}

model Customer {
  customerId   Int       @id @default(autoincrement()) @map("Customer_id")
  name         String    @map("Name")
  phoneNum     String?   @unique @map("Phone_Num")
  saleInvoices Invoice[] @relation("CustomerInvoices")
  returns      Return[]  @relation("CustomerReturns")

  @@map("Customers")
}

model Item {
  itemId          Int             @id @default(autoincrement()) @map("Item_Id")
  code            String          @unique @map("Code")
  name            String          @map("Name")
  purchasePrice   Decimal         @map("Purchas_Price")
  salePrice       Decimal         @map("Sale-Price")
  currentQuantity Int             @default(0) @map("Current_Quantity")
  invoiceTerms    InvoiceTerm[]
  returnItems     ReturnItem[]
  stockMovements  StockMovement[]

  @@map("Items")
}

model Invoice {
  invoiceId   Int      @id @default(autoincrement()) @map("Invoice_Id")
  invoiceNum  String   @unique @map("Invoice_Num")
  invoiceType String   @map("Invoice_Type")
  customerId  Int?     @map("Customer_Id")
  supplierId  Int?     @map("Supplier_Id")
  invoiceDate DateTime @map("Invoice_Date")

  customer       Customer?       @relation("CustomerInvoices", fields: [customerId], references: [customerId])
  supplier       Supplier?       @relation("SupplierInvoices", fields: [supplierId], references: [supplierId])
  invoiceTerms   InvoiceTerm[]
  payments       Payment[]
  returns        Return[]
  stockMovements StockMovement[]

  @@index([customerId])
  @@index([supplierId])
  @@index([invoiceDate])
  @@map("Invoices")
}

model InvoiceTerm {
  invoiceId Int     @map("Invoice_Id")
  itemId    Int     @map("Item_Id")
  quantity  Int     @map("Quantity")
  price     Decimal @map("Price")

  invoice Invoice @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [itemId])

  @@id([invoiceId, itemId])
  @@index([itemId])
  @@map("Invoice_Terms")
}

model Return {
  returnId   Int      @id @default(autoincrement()) @map("Return_Id")
  invoiceId  Int      @map("Invoice_Id")
  returnDate DateTime @default(now()) @map("Return_Date")
  returnType String   @map("Return_Type") // "from_customer" or "to_supplier"
  reason     String?  @map("Reason")
  customerId Int?     @map("Customer_Id")
  supplierId Int?     @map("Supplier_Id")

  invoice  Invoice   @relation(fields: [invoiceId], references: [invoiceId], onDelete: NoAction, onUpdate: NoAction)
  customer Customer? @relation("CustomerReturns", fields: [customerId], references: [customerId])
  supplier Supplier? @relation("SupplierReturns", fields: [supplierId], references: [supplierId])

  returnItems    ReturnItem[]
  stockMovements StockMovement[]

  @@index([invoiceId])
  @@index([customerId])
  @@index([supplierId])
  @@map("Returns")
}

model ReturnItem {
  returnId Int     @map("Return_Id")
  itemId   Int     @map("Item_Id")
  quantity Int     @map("Quantity")
  price    Decimal @map("Price")

  return Return @relation(fields: [returnId], references: [returnId], onDelete: Cascade)
  item   Item   @relation(fields: [itemId], references: [itemId])

  @@id([returnId, itemId])
  @@index([itemId])
  @@map("Return_Items")
}

model StockMovement {
  movementId   Int      @id @default(autoincrement()) @map("Movement_Id")
  itemId       Int      @map("Item_Id")
  movementType String   @map("Movement_Type") // sale_out - purchase_in - sale_return_in - purchase_return_out
  quantity     Int      @map("Quantity")
  movementDate DateTime @map("Movement_Date")
  invoiceId    Int?     @map("Invoice_Id")
  returnId     Int?     @map("Return_Id")

  item    Item     @relation(fields: [itemId], references: [itemId], onDelete: NoAction, onUpdate: NoAction)
  invoice Invoice? @relation(fields: [invoiceId], references: [invoiceId], onDelete: NoAction, onUpdate: NoAction)
  return  Return?  @relation(fields: [returnId], references: [returnId], onDelete: NoAction, onUpdate: NoAction)

  @@index([itemId])
  @@index([invoiceId])
  @@index([returnId])
  @@index([movementDate])
  @@map("Stock_Movement")
}

model Payment {
  paymentId     Int      @id @default(autoincrement()) @map("Payment_Id")
  invoiceId     Int      @map("Invoice_Id")
  amount        Decimal  @map("Amount")
  paymentDate   DateTime @map("Payment_Date")
  paymentMethod String   @map("Payment_Method")
  notes         String?  @map("Notes")

  invoice Invoice @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)

  @@index([invoiceId])
  @@map("Payments")
}

model Expense {
  expenseId   Int      @id @default(autoincrement()) @map("Expense_Id")
  type        String   @map("Type")
  amount      Decimal  @map("Amount")
  expenseDate DateTime @map("Expense_Date")
  description String?  @map("Description")

  @@index([expenseDate])
  @@map("Expenses")
}